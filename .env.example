# Application mode: development or production
ENVIRONMENT=development

# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:REPLACE_WITH_REAL_BOT_TOKEN

# Comma-separated Telegram user IDs for admins
ADMIN_IDS=123456789

# PostgreSQL connection string
# Local example:
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/schoolbridge

# Redis connection string used by FSM storage
# Local example:
REDIS_URL=redis://localhost:6379/0

# Optional SQLAlchemy pool tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Optional log level
LOG_LEVEL=INFO
